{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Algo: dev",
      "type": "shell",
      "command": "npm run dev -- --port 5173 --strictPort",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^(.*):(\\d+):(\\d+): (.*)$", "file": 1, "line": 2, "column": 3, "message": 4 },
        "background": { "activeOnStart": true, "beginsPattern": ".*", "endsPattern": ".*Local:.*" }
      }
    },
    {
      "label": "Algo: build",
      "type": "shell",
      "command": "npm run build",
      "group": "build",
      "problemMatcher": "$tsc"
    }
  ]
}
